<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PrimeDrive Motor — Buy, Rent & Swap Cars</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}?v=2">

<meta name="description" content="Buy, sell, swap and rent quality cars. Browse available vehicles online.">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ brand_name }}">
<meta property="og:description" content="Browse quality cars, book a test drive, swap or sell yours - all with WhatsApp support.">
<meta property="og:url" content="{{ request.url_root }}">
<meta property="og:image" content="{{ url_for('static', filename='img/hero.jpg', _external=True, _scheme='https') }}">
<meta name="twitter:card" content="summary_large_image">
</head>

<body class="page-home">

    {% include '_nav.html' %}

    <div class="hero-banner">

        <!-- Animated hero backgrounds -->
        <div class="hero-slides">

            <div class="hero-slide active"
                style="background-image: url('{{ url_for('static', filename='img/hero.jpg') }}');">
            </div>

            <div class="hero-slide" style="background-image: url('{{ url_for('static', filename='img/hero1.jpg') }}');">
            </div>

            <div class="hero-slide" style="background-image: url('{{ url_for('static', filename='img/hero3.jpg') }}');">
            </div>

            <div class="hero-slide" style="background-image: url('{{ url_for('static', filename='img/hero4.jpg') }}');">
            </div>

        </div>

        <!-- Dark professional overlay -->
        <div class="hero-overlay"></div>

        <!-- Hero content -->
        <div class="hero-content">

            <h1>Drive Something <span>Exceptional.</span></h1>

            <p>
                Discover quality vehicles carefully selected for comfort, performance,
                and your lifestyle. Your next car is waiting.
            </p>

            <div class="pill-row">

                <a href="{{ url_for('home', listing_type='sale') }}#available-cars" class="pill">
                    🚗 Buy a Car
                </a>

                <a href="{{ url_for('sell_car') }}" class="pill">
                    💲 Sell Your Car
                </a>

                <a href="{{ url_for('swap_car') }}" class="pill">🔄 Swap a Car</a>

                <a href="https://wa.me/{{ whatsapp_number }}?text=Hi%2C%20I%27d%20like%20to%20trade%20in%20my%20car."
                    target="_blank" rel="noopener noreferrer" class="pill">
                    🔄 Trade-In
                </a>

                <a href="{{ url_for('home', listing_type='rent') }}#available-cars" class="pill">
                    🔑 Rent a Car
                </a>

            </div>


        </div>


        <!-- Slide indicators -->
        <div class="hero-dots">
            <button class="hero-dot active" data-slide="0"></button>
            <button class="hero-dot" data-slide="1"></button>
            <button class="hero-dot" data-slide="2"></button>
            <button class="hero-dot" data-slide="3"></button>
        </div>

    </div>


    <form method="GET" class="filters">
        <input type="text" name="q" placeholder="Search make, model, year..." value="{{ request.args.get('q', '') }}"
            style="flex:1; min-width:200px;">
        <select name="make">
            <option value="">All Makes</option>
            {% for m in makes %}
            <option value="{{ m }}" {% if request.args.get('make')==m %}selected{% endif %}>{{ m }}</option>
            {% endfor %}
        </select>
        <select name="sort">
            <option value="newest" {% if request.args.get('sort', 'newest' )=='newest' %}selected{% endif %}>Newest
                First</option>
            <option value="price_low" {% if request.args.get('sort')=='price_low' %}selected{% endif %}>Price: Low to
                High</option>
            <option value="price_high" {% if request.args.get('sort')=='price_high' %}selected{% endif %}>Price: High to
                Low</option>
        </select>
        <button type="submit">Search</button>
        <a href="{{ url_for('home') }}" class="btn-outline">Clear</a>
    </form>

    <div id="available-cars" class="section-label">
        {{ cars|length }} car{{ 's' if cars|length != 1 else '' }} available
    </div>

    <div class="grid">
        {% for item in cars %}
        {% set car = item.car %}
        {% set photos = item.photos %}

        <div class="card">

            <!-- =====================================================
             VEHICLE PHOTO
             ===================================================== -->
            <div class="card-photo">

                {% if photos %}

                {% set ns = namespace(urls=[]) %}

                {% for p in photos %}
                {% set ns.urls = ns.urls + [url_for('static', filename='uploads/' + p)] %}
                {% endfor %}

                <img class="rotating-photo" src="{{ ns.urls[0] }}" data-photos='{{ ns.urls | tojson }}' data-index="0"
                    alt="{{ car['year'] }} {{ car['make'] }} {{ car['model'] }}">

                {% if ns.urls|length > 1 %}

                <!-- Previous Photo -->
                <button type="button" class="photo-arrow prev" onclick="event.preventDefault(); changePhoto(this, -1)"
                    aria-label="Previous photo">
                    ‹
                </button>

                <!-- Next Photo -->
                <button type="button" class="photo-arrow next" onclick="event.preventDefault(); changePhoto(this, 1)"
                    aria-label="Next photo">
                    ›
                </button>

                <!-- Photo Dots -->
                <div class="photo-dots">

                    {% for p in ns.urls %}

                    <span class="photo-dot {% if loop.index0 == 0 %}active{% endif %}"></span>

                    {% endfor %}

                </div>

                {% endif %}

                {% else %}

                <!-- No Photo -->
                <div class="no-photo">

                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                        <path d="M3 13l1.5-4.5A2 2 0 0 1 6.4 7h11.2a2 2 0 0 1 1.9 1.5L21 13" />
                        <rect x="2" y="13" width="20" height="6" rx="1.5" />
                        <circle cx="7" cy="19.5" r="1.5" />
                        <circle cx="17" cy="19.5" r="1.5" />
                    </svg>

                </div>

                {% endif %}


                <!-- =================================================
                 LISTING BADGE
                 ================================================= -->

                <div class="card-tags">
                    <span class="badge {% if car['sold'] == 1 %}badge-sold{% endif %}">{% if car['sold'] == 1 %}Sold{% else %}Available{% endif %}</span>
                    {% if car["condition"] %}<span class="cond-tag {% if car["condition"] == "Foreign Used" %}cond-foreign{% elif car["condition"] == "Nigerian Used" %}cond-local{% else %}cond-new{% endif %}">{{ car["condition"] }}</span>{% endif %}
                </div>

            </div>


            <!-- =====================================================
             VEHICLE INFORMATION
             ===================================================== -->

            <div class="card-body">

                <div class="card-top">
                    <span class="year-chip">{{ car["year"] }}</span>
                    {% if car["body_type"] %}<span class="body-chip">{{ car["body_type"] }}</span>{% endif %}
                </div>

                <h3>
                    <a href="{{ url_for('car_detail', car_id=car['id']) }}">{{ car["make"] }} {{ car["model"] }}</a>
                </h3>

                <div class="price">₦{{ "{:,}".format(car["price"]) }}</div>

                <div class="spec-grid">
                    <div class="spec"><small>Mileage</small><b>{% if car["mileage"] %}{{ car["mileage"] }} km{% else %}&mdash;{% endif %}</b></div>
                    <div class="spec"><small>Gearbox</small><b>{{ car["transmission"] or "—" }}</b></div>
                    <div class="spec"><small>Fuel</small><b>{{ car["fuel_type"] or "—" }}</b></div>
                </div>

                <!-- Description -->
                {% if car["description"] %}

                <p class="card-meta">
                    {{ car["description"]|truncate(95, false, "…") }}
                </p>

                {% endif %}


                <!-- =================================================
                 VIEW DETAILS BUTTON
                 ================================================= -->

                <a href="{{ url_for('car_detail', car_id=car['id']) }}" class="view-details-btn">
                    <span>View Details</span>
                    <span class="view-details-arrow">→</span>
                </a>

            </div>

        </div>

        {% endfor %}
    </div>

    <section id="services" class="services-section">
        <div class="section-label" style="padding:0 0 8px;">What We Offer</div>
        <h2 style="font-size:28px; font-weight:400; margin:0 auto 12px; max-width:600px; text-align:center;">A Complete
            Automotive Experience</h2>
        <p style="color:var(--muted); font-size:15px; margin:0 auto; max-width:600px; text-align:center;">From
            acquisition to aftercare, every service is delivered with the same standard of care and discretion our
            clients expect.</p>

        <div class="services-grid">
            <div class="service-card">
                <span class="icon">🚗</span>
                <h3>Vehicle Sales</h3>
                <p>A curated inventory of thoroughly inspected vehicles, competitively priced and ready for immediate
                    delivery.</p>
            </div>
            <div class="service-card">
                <span class="icon">💲</span>
                <h3>We Purchase Vehicles</h3>
                <p>Fair, prompt valuations for used, damaged, or non-running vehicles — including complimentary
                    collection.</p>
            </div>
            <div class="service-card">
                <span class="icon">⇄</span>
                <h3>Vehicle Exchange</h3>
                <p>Upgrade seamlessly through our exchange programme, with transparent valuation on your current
                    vehicle.</p>
            </div>
            <div class="service-card">
                <span class="icon">🔄</span>
                <h3>Trade Facilitation</h3>
                <p>Structured trade arrangements designed around what you're looking to achieve, not just what's in
                    stock.</p>
            </div>
            <div class="service-card">
                <span class="icon">🔐</span>
                <h3>Vehicle Hire</h3>
                <p>A well-maintained fleet available for corporate engagements, private events, and extended travel.</p>
            </div>
            <div class="service-card">
                <span class="icon">🚙</span>
                <h3>Bespoke Sourcing</h3>
                <p>Looking for something specific? We source and secure vehicles to your exact requirements.</p>
            </div>
            <div class="service-card">
                <span class="icon">✈️</span>
                <h3>Vehicle Importation</h3>
                <p>End-to-end importation of new and foreign-used vehicles, managed from origin to delivery.</p>
            </div>
            <div class="service-card">
                <span class="icon">📄</span>
                <h3>Documentation & Registration</h3>
                <p>Complete handling of registration and paperwork, so ownership transfers without friction.</p>
            </div>
            <div class="service-card">
                <span class="icon">🔧</span>
                <h3>Customization & Upgrades</h3>
                <p>Refine your vehicle's performance and presentation through our professional customization service.
                </p>
            </div>
            <div class="service-card">
                <span class="icon">🔴</span>
                <h3>Diagnostics & Servicing</h3>
                <p>Precision diagnostics and maintenance carried out by certified automotive technicians.</p>
            </div>
            <div class="service-card">
                <span class="icon">💵</span>
                <h3>Financing Solutions</h3>
                <p>Structured payment plans tailored to make vehicle ownership straightforward and accessible.</p>
            </div>
            <div class="service-card">
                <span class="icon">🚘</span>
                <h3>Nationwide Delivery</h3>
                <p>Secure, tracked delivery of your vehicle to any location across Nigeria.</p>
            </div>
            <div class="service-card">
                <span class="icon">🔍</span>
                <h3>Pre-Purchase Inspection</h3>
                <p>A thorough, independent inspection so every decision is made with complete confidence.</p>
            </div>
            <div class="service-card">
                <span class="icon">🚚</span>
                <h3>Complimentary Vehicle Removal</h3>
                <p>We arrange collection of your scrapped or non-running vehicle at no cost to you.</p>
            </div>
        </div>
    </section>

    <section id="about" class="about-section" style="max-width:1100px;">
        <div class="section-label" style="padding:0 0 8px;">About Us</div>
        <h2>Built on trust. Defined by standards.</h2>

        <div class="about-grid">
            <div>
                <p>PrimeDrive Motor was founded on a simple premise: buying or selling a vehicle should never involve
                    guesswork. Every car in our collection is personally inspected before it reaches a listing, every
                    price is stated plainly, and every client deals directly with us — no intermediaries, no inflated
                    margins, no surprises.</p>
                <p>What began as a commitment to honest dealing has grown into a full-service operation — spanning
                    sales, acquisitions, importation, financing, and aftercare — built around one standard: the way we'd
                    want to be treated as buyers ourselves.</p>
                <div class="trust-row">
                    <div class="trust-item">
                        <span class="num">{{ cars|length }}+</span>
                        <span class="label">Vehicles Available</span>
                    </div>
                    <div class="trust-item">
                        <span class="num">100%</span>
                        <span class="label">Inspected Before Listing</span>
                    </div>
                    <div class="trust-item">
                        <span class="num">Anytime</span>
                        <span class="label">We Reply on WhatsApp</span>
                    </div>
                </div>
            </div>
            <img src="{{ url_for('static', filename='img/about.jpg') }}" alt="{{ brand_name }} vehicle inventory">
        </div>
    </section>

    <section id="contact" class="contact-section">
        <div class="section-label" style="padding:0 0 8px;">Get In Touch</div>
        <h2 style="font-size:28px; font-weight:400; margin:0;">Visit, Call, or Message Us</h2>

        <div class="contact-grid">
            <div>
                <div class="contact-detail">
                    <div>
                        <span class="label">Showroom Address</span>
                        {{ dealer_address }}
                    </div>
                </div>
                <div class="contact-detail">
                    <div>
                        <span class="label">Phone</span>
                        <a href="tel:{{ phone_number }}" style="color:var(--ivory); text-decoration:none;">{{
                            phone_number }}</a>
                    </div>
                </div>
                <div class="contact-detail">
                    <div>
                        <span class="label">Hours</span>
                        Monday – Saturday, 9:00 AM – 6:00 PM
                    </div>
                </div>

                <div class="action-row" style="margin-top:28px;">

                    <a href="https://wa.me/{{ whatsapp_number }}?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20your%20cars"
                        target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
                        💬 Chat on WhatsApp
                    </a>

                    <a href="tel:{{ phone_number }}" class="btn-call">
                        📞 Call Us
                    </a>

                </div>
            </div>

            <div class="map-frame">
                <iframe width="100%" height="280" style="border:0; display:block;" loading="lazy" allowfullscreen
                    src="https://www.google.com/maps?q={{ dealer_address | urlencode }}&output=embed"></iframe>
            </div>
        </div>
    </section>

    <section id="gallery" class="gallery-section">
        <div class="section-label" style="padding:0 0 8px;">Our Gallery</div>
        <h2 style="font-size:28px; font-weight:500; margin:0 0 12px;">See Our Collection</h2>
        <p style="color:var(--muted); font-size:15px; margin:0;">A closer look at the vehicles currently available.
            Click any photo to view full details.</p>

        <div class="gallery-grid" id="galleryGrid">
            {% for p in gallery_photos %}
            <div class="gallery-item {% if loop.index > 12 %}hidden-extra{% endif %}"
                data-photos='{{ p["photos"]|tojson }}'
                data-base="{{ url_for('static', filename='uploads/') }}" data-i="0">
                <a href="{{ url_for('car_detail', car_id=p['car_id']) }}" class="g-link">
                    <img src="{{ url_for('static', filename='uploads/' + p['filename']) }}"
                        alt="{{ p['make'] }} {{ p['model'] }}">
                    <div class="overlay">
                        <span>{{ p['year'] }} {{ p['make'] }} {{ p['model'] }}</span>
                    </div>
                </a>
                {% if p['photos']|length > 1 %}
                <button type="button" class="g-nav g-prev" data-dir="-1" aria-label="Previous photo">&#8249;</button>
                <button type="button" class="g-nav g-next" data-dir="1" aria-label="Next photo">&#8250;</button>
                <span class="g-count">1/{{ p['photos']|length }}</span>
                {% endif %}
            </div>
            {% endfor %}

        </div>

        {% if gallery_photos|length > 12 %}
        <button type="button" class="btn-outline gallery-view-more" id="galleryViewMoreBtn" data-expanded="false">
            View More Photos
        </button>
        {% endif %}

    </section>

    <footer
        style="border-top:1px solid var(--hairline); margin-top:64px; padding:40px 48px; color:var(--muted); font-size:13px;">
        <div
            style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px; max-width:1200px; margin:0 auto;">
            <div>
                <div class="brand" style="font-size:16px; margin-bottom:8px;">{{ brand_html }}</div>
                <p style="margin:0 0 12px; max-width:280px;">Buy, rent, or swap — quality cars, honestly presented.</p>
                <div style="display:flex; gap:10px;">
                    <a href="{{ instagram }}" target="_blank" class="social-icon"
                        style="color:var(--muted); text-decoration:none;" aria-label="Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8">
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <circle cx="12" cy="12" r="4" />
                            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" />
                        </svg>
                    </a>
                    <a href="{{ facebook }}" target="_blank" class="social-icon"
                        style="color:var(--muted); text-decoration:none;" aria-label="Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                        </svg>
                    </a>
                    <a href="{{ whatsapp }}" target="_blank" class="social-icon"
                        style="color:var(--muted); text-decoration:none;" aria-label="WhatsApp">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.8">
                            <path d="M4 4l16 16M20 4L4 20" />
                        </svg>
                    </a>
                </div>
            </div>
            <div>
                <p style="margin:0 0 6px; color:var(--ivory);">Contact</p>
                <p style="margin:0 0 4px;">{{ dealer_address }}</p>
                <p style="margin:0;"><a href="tel:{{ phone_number }}"
                        style="color:var(--muted); text-decoration:none;">{{ phone_number }}</a></p>
            </div>
            <div>
                <p style="margin:0 0 6px; color:var(--ivory);">Browse</p>
                <p style="margin:0 0 4px;"><a href="{{ url_for('home', listing_type='sale') }}"
                        style="color:var(--muted); text-decoration:none;">For Sale</a></p>
                <p style="margin:0 0 4px;"><a href="{{ url_for('home', listing_type='rent') }}"
                        style="color:var(--muted); text-decoration:none;">For Rent</a></p>
                <p style="margin:0;"><a href="{{ url_for('swap_car') }}"
                        style="color:var(--muted); text-decoration:none;">Swap Your Car</a></p>
            </div>
        </div>
        <p style="text-align:center; margin:32px 0 0; font-size:12px; color:#5A564F;">© 2026 {{ brand_name }}. All rights
            reserved.</p>
    </footer>

    <a href="https://wa.me/{{ 2347066108664 }}?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20your%20cars"
        target="_blank" rel="noopener noreferrer" class="sticky-whatsapp" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 32 32" fill="white">
            <path
                d="M16 0C7.163 0 0 7.163 0 16c0 2.837.744 5.5 2.04 7.805L0 32l8.413-2.21A15.9 15.9 0 0 0 16 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.09c-2.49 0-4.82-.69-6.81-1.887l-.488-.29-5 1.31 1.337-4.87-.318-.5A13.07 13.07 0 0 1 2.91 16C2.91 8.775 8.775 2.91 16 2.91S29.09 8.775 29.09 16 23.225 29.09 16 29.09zm7.17-9.82c-.39-.195-2.31-1.14-2.67-1.27-.36-.13-.62-.195-.88.195-.26.39-1.01 1.27-1.24 1.53-.23.26-.46.29-.85.1-.39-.195-1.65-.61-3.14-1.94-1.16-1.04-1.95-2.32-2.18-2.71-.23-.39-.025-.6.17-.795.175-.175.39-.46.585-.69.195-.23.26-.39.39-.65.13-.26.065-.49-.03-.685-.1-.195-.88-2.12-1.2-2.9-.317-.76-.64-.655-.88-.667-.228-.01-.49-.012-.75-.012-.26 0-.685.097-1.045.487-.36.39-1.37 1.34-1.37 3.27 0 1.93 1.4 3.79 1.6 4.05.195.26 2.76 4.21 6.69 5.9.935.405 1.665.647 2.235.828.94.3 1.795.258 2.47.157.754-.113 2.31-.944 2.635-1.856.325-.912.325-1.69.228-1.856-.098-.166-.358-.26-.748-.456z" />
        </svg>
    </a>

    <button id="backToTop" onclick="window.scrollTo({top:0, behavior:'smooth'})">↑</button>

    <script src="{{ url_for('static', filename='js/script.js') }}"></script>


<script>
    (function () {
        var grid = document.getElementById('galleryGrid');
        if (!grid) return;
        grid.addEventListener('click', function (e) {
            var btn = e.target.closest('.g-nav');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            var tile = btn.closest('.gallery-item');
            var photos = JSON.parse(tile.getAttribute('data-photos'));
            var i = parseInt(tile.getAttribute('data-i'), 10) || 0;
            i = (i + parseInt(btn.getAttribute('data-dir'), 10) + photos.length) % photos.length;
            tile.setAttribute('data-i', i);
            tile.querySelector('img').src = tile.getAttribute('data-base') + photos[i];
            var c = tile.querySelector('.g-count');
            if (c) c.textContent = (i + 1) + '/' + photos.length;
        });
    })();
    </script>

<script id="nav-spy">
(function () {
  var links = Array.prototype.filter.call(document.querySelectorAll('.nav-links a'), function (a) {
    return a.hash && a.hash.length > 1 && a.pathname === location.pathname;
  });
  var items = links.map(function (a) { return { a: a, el: document.querySelector(a.hash) }; })
                   .filter(function (x) { return x.el; });
  function spy() {
    var y = window.scrollY + 160, cur = null;
    items.forEach(function (x) { if (x.el.getBoundingClientRect().top + window.scrollY <= y) cur = x; });
    document.querySelectorAll('.nav-links a').forEach(function (a) { a.classList.remove('active'); });
    if (cur) { cur.a.classList.add('active'); } else { var hm = document.querySelector('.nav-links a:not([href*="#"])'); if (hm && hm.pathname === location.pathname) hm.classList.add('active'); }
  }
  window.addEventListener('scroll', spy, { passive: true });
  spy();
  document.querySelectorAll('.nav-links a').forEach(function (a) {
    a.addEventListener('click', function () {
      var nl = document.querySelector('.nav-links');
      if (nl) nl.classList.remove('open');
    });
  });
})();
</script>

<script id="swipe-js">
(function () {
  function swipe(el, pick) {
    var sx = 0, sy = 0, on = false;
    el.addEventListener('touchstart', function (e) {
      sx = e.touches[0].clientX; sy = e.touches[0].clientY; on = true;
    }, { passive: true });
    el.addEventListener('touchend', function (e) {
      if (!on) return;
      on = false;
      var dx = e.changedTouches[0].clientX - sx;
      var dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        var b = pick(dx < 0 ? 'next' : 'prev');
        if (b) b.click();
      }
    }, { passive: true });
  }
  function fade(img) {
    if (!img || !window.MutationObserver) return;
    new MutationObserver(function () {
      img.classList.remove('photo-fade');
      void img.offsetWidth;
      img.classList.add('photo-fade');
    }).observe(img, { attributes: true, attributeFilter: ['src'] });
  }
  document.querySelectorAll('.card-photo').forEach(function (el) {
    swipe(el, function (d) { return el.querySelector('.photo-arrow.' + d); });
    fade(el.querySelector('.rotating-photo'));
  });
  document.querySelectorAll('.gallery-item').forEach(function (el) {
    swipe(el, function (d) { return el.querySelector('.g-' + (d === 'next' ? 'next' : 'prev')); });
    fade(el.querySelector('img'));
  });
})();
</script>

<script id="dd-js">
(function () {
  if (!window.matchMedia('(hover:hover) and (pointer:fine)').matches) return;
  var list = null, cur = null, hi = -1;
  function close() { if (list) { list.remove(); list = null; } cur = null; }
  function items() { return list ? list.querySelectorAll('li') : []; }
  function mark(i) {
    var it = items();
    it.forEach(function (x) { x.classList.remove('hl'); });
    hi = Math.max(0, Math.min(it.length - 1, i));
    if (it[hi]) { it[hi].classList.add('hl'); it[hi].scrollIntoView({ block: 'nearest' }); }
  }
  function choose(i) {
    if (!cur) return;
    cur.selectedIndex = i;
    cur.dispatchEvent(new Event('change', { bubbles: true }));
    close();
  }
  function open(sel) {
    close();
    cur = sel;
    list = document.createElement('ul');
    list.className = 'dd-list';
    Array.prototype.forEach.call(sel.options, function (o, i) {
      var li = document.createElement('li');
      li.textContent = o.text;
      if (i === sel.selectedIndex) li.className = 'sel';
      li.addEventListener('mousedown', function (e) { e.preventDefault(); });
      li.addEventListener('click', function () { choose(i); });
      li.addEventListener('mouseenter', function () { mark(i); });
      list.appendChild(li);
    });
    document.body.appendChild(list);
    var r = sel.getBoundingClientRect();
    list.style.top = (r.bottom + window.scrollY + 6) + 'px';
    list.style.left = (r.left + window.scrollX) + 'px';
    list.style.minWidth = r.width + 'px';
    mark(sel.selectedIndex);
  }
  document.querySelectorAll('.filters select').forEach(function (sel) {
    sel.addEventListener('mousedown', function (e) {
      e.preventDefault();
      sel.focus();
      (list && cur === sel) ? close() : open(sel);
    });
    sel.addEventListener('keydown', function (e) {
      if (!list) {
        if (['Enter', ' ', 'ArrowDown', 'ArrowUp'].indexOf(e.key) > -1) { e.preventDefault(); open(sel); }
        return;
      }
      if (e.key === 'ArrowDown') { e.preventDefault(); mark(hi + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); mark(hi - 1); }
      else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(hi); }
      else if (e.key === 'Escape' || e.key === 'Tab') { close(); }
    });
  });
  document.addEventListener('mousedown', function (e) {
    if (list && !list.contains(e.target) && e.target !== cur) close();
  });
  window.addEventListener('resize', close);
})();
</script>

<script id="auction-cards-js">
(function () {
  fetch('/auctions.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (map) {
    function money(n) { return '\u20a6' + Number(n).toLocaleString('en-NG'); }
    function short(s) {
      var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
      return d ? d + 'd ' + h + 'h left' : (h ? h + 'h ' + m + 'm left' : m + 'm left');
    }
    document.querySelectorAll('.card').forEach(function (card) {
      var a = card.querySelector('.view-details-btn');
      var m = a && (a.getAttribute('href') || '').match(/\/car\/(\d+)/);
      var st = m && map[m[1]];
      if (!st || !st.enabled) return;
      var tags = card.querySelector('.card-tags');
      if (tags) {
        var t = document.createElement('span');
        t.className = 'auction-tag';
        t.textContent = st.ended ? 'Auction ended' : 'Auction';
        tags.appendChild(t);
      }
      var price = card.querySelector('.price');
      if (price) {
        var line = document.createElement('div');
        line.className = 'auction-line';
        line.textContent = (st.count ? 'Current bid ' + money(st.current) : 'Starting bid ' + money(st.start)) +
          (!st.ended && st.seconds_left !== null ? ' \u00b7 ' + short(st.seconds_left) : '');
        price.after(line);
      }
    });
  }).catch(function () {});
})();
</script>
</body>

</html>